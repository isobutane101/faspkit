# Port the FASP listens on
PORT=3000

# Public base URL of this FASP. MUST match what fediverse servers use to reach
# you, byte-for-byte — signature verification covers @target-uri.
FASP_BASE_URL=https://fasp.example.com

# Human-readable name shown to instance admins during registration.
FASP_NAME=faspkit

# Where the JSON store writes. Contains PRIVATE KEYS — never commit.
FASPKIT_DATA=./data

# Passphrase used to encrypt private keys at rest (AES-256-GCM). Any length;
# it is stretched with scrypt. REQUIRED when NODE_ENV=production — startup
# fails rather than silently writing keys in plaintext. Losing it makes an
# existing store unreadable, so back it up with the data.
FASPKIT_SECRET=

# Set to 1 to run src/index.ts as a standalone server.
FASPKIT_RUN=0
