# Port the FASP listens on
PORT=3000

# Public URL other servers reach this FASP at. MUST match byte-for-byte what
# they call — signature verification covers the full request URI. Use a tunnel
# rather than localhost when testing against a real server.
FASP_BASE_URL=https://fasp.example.com

# Name and actor username shown to instance admins.
FASP_NAME=faspkit
FASP_USERNAME=faspkit
FASP_CONTACT_EMAIL=

# Where keys and state are stored. Back this up.
FASPKIT_DATA=./data

# Encrypts private keys at rest (AES-256-GCM). Any length; stretched with
# scrypt. REQUIRED when NODE_ENV=production — startup fails rather than
# silently writing keys in plaintext. Back it up WITH the data directory:
# without it the stored keys cannot be read.
#   openssl rand -base64 32
FASPKIT_SECRET=

# Dashboard token. Leave unset to have one generated on first run and printed
# to the console.
FASPKIT_ADMIN_TOKEN=
