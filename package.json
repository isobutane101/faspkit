{
  "name": "faspkit",
  "version": "0.1.0",
  "description": "Run a Fediverse Auxiliary Service Provider (FASP) \u2014 search, trends and follow recommendations for Mastodon and compatible servers",
  "main": "dist/index.js",
  "scripts": {
    "test": "tsx scripts/crypto.test.ts && tsx scripts/consent.test.ts && tsx scripts/store.test.ts && tsx scripts/e2e.ts && tsx scripts/datasharing.test.ts && tsx scripts/discovery.test.ts && tsx scripts/app.test.ts",
    "test:crypto": "tsx scripts/crypto.test.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test:consent": "tsx scripts/consent.test.ts",
    "test:datasharing": "tsx scripts/datasharing.test.ts",
    "test:store": "tsx scripts/store.test.ts",
    "test:discovery": "tsx scripts/discovery.test.ts",
    "start": "node bin/faspkit.js",
    "prepublishOnly": "npm run build",
    "test:app": "tsx scripts/app.test.ts"
  },
  "keywords": [
    "fasp",
    "fediverse",
    "mastodon",
    "activitypub",
    "rfc9421",
    "http-message-signatures"
  ],
  "author": "isobutane101",
  "license": "AGPL-3.0",
  "dependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/isobutane101/faspkit"
  },
  "bin": {
    "faspkit": "bin/faspkit.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  }
}
